# 复制为 .env 后填入自己的密钥。不要分享或提交 .env。
OPENROUTER_API_KEY=在这里填写密钥
OPENROUTER_MODEL=deepseek-flash
OPENROUTER_BASE_URL=https://api.deepseek.com
OPENROUTER_APP_NAME=OntoRAG
OPENROUTER_SITE_URL=https://ontorag.org
ONTORAG_SERVICE_API_KEY=请替换为一段随机长密钥
STORAGE_BACKEND=local
# 在 Vercel 中设置 DATABASE_URL、BLOB_READ_WRITE_TOKEN，STORAGE_BACKEND=blob。
